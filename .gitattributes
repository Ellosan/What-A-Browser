# Check every text file out with LF endings, on every platform.
#
# The CSS and HTML parsers cope with CRLF, but tests that compare exact strings
# would not, and a stylesheet that differs between platforms is a bad way to
# find that out.
* text=auto eol=lf

# Screenshots are binary and must not be touched.
*.png binary

# Exceptions for the committed Gradle wrapper. `cmd.exe` wants CRLF in a batch
# file; the Unix `gradlew` must keep LF, which the rule above already gives it,
# or no shell will run it.
*.bat text eol=crlf
*.jar binary
