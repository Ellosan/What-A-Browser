/target/
**/*.rs.bk
*.pdb

# Images produced by `wat render` and `wat shot`
/*.png
!docs/images/*.png

# Release archives, if the packaging steps are rehearsed by hand
/wat-*.tar.gz
/wat-*.zip
/wat-*.apk
/wat-*.sha256

# Android build output
/android/.gradle/
/android/build/
/android/app/build/
/android/app/src/main/jniLibs/
/android/local.properties

# The Chromium fork's checkout: tens of gigabytes, fetched not committed.
/chromium/checkout/

# WebView app build output
/android-webview/.gradle/
/android-webview/.kotlin/
/android-webview/build/
/android-webview/app/build/
/android-webview/local.properties

# A committed signing key is deliberate, so it is not ignored — but a keystore
# left anywhere else is a private key in a repository by accident.
*.jks
*.jks.base64
*.keystore
!signing/release.jks
