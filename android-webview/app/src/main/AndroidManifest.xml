<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Not a permission: `queries` is how an app is allowed to *see* that another
      one is installed on Android 11 and later. Only Orbot, and only so the Tor
      window can say "start Orbot" instead of "something went wrong".
    -->
    <queries>
        <package android:name="org.torproject.android" />
    </queries>

    <!--
      Not requested, deliberately: location, camera, microphone, contacts,
      storage. A browser that never asks cannot be tricked into handing them to a
      page, and nothing here needs them.
    -->

    <application
        android:name=".BrowserApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wat"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".BrowserActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offered as a browser for http and https links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          The private windows. Each runs in a process of its own, which is the
          whole mechanism: Android's WebView keeps one cookie and storage jar per
          process, so this is what makes a private window actually separate
          rather than a flag on a tab. A task of its own too, so it appears
          beside the ordinary browser rather than inside it, and leaves recents
          when it is closed.
        -->
        <activity
            android:name=".CatBrowserActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":cat"
            android:taskAffinity="com.whatabrowser.wat.webview.cat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LionBrowserActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":lion"
            android:taskAffinity="com.whatabrowser.wat.webview.lion"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
