<?xml version="1.0" encoding="utf-8"?>
<!--
  Page underneath, glass on top: the same arrangement the desktop browser uses,
  and the reason the bars are translucent rather than opaque.

  The pages live in a container rather than in a single WebView, because there is
  a view per tab and `Tabs` adds and removes them as tabs come forward and are
  frozen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="64dp" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="@string/lock_secure"
                android:textColor="@color/success"
                android:textSize="13sp" />

            <AutoCompleteTextView
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:completionThreshold="2"
                android:dropDownVerticalOffset="4dp"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tab_count"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/tabs"
                android:gravity="center"
                android:text="@string/one"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/menu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/menu"
                android:gravity="center"
                android:text="@string/menu_glyph"
                android:textColor="@color/text"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- A thin line rather than a spinner: it says how far along, not just
             that something is happening. -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginTop="60dp"
        android:layout_marginHorizontal="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@null"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/find_matches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/find_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/find_previous"
            android:gravity="center"
            android:text="@string/back_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/find_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/find_next"
            android:gravity="center"
            android:text="@string/forward_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/find_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/close"
            android:gravity="center"
            android:text="@string/close_glyph"
            android:textColor="@color/text"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/back"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/back"
            android:text="@string/back_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/forward"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/forward"
            android:text="@string/forward_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/reload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/reload"
            android:text="@string/reload_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/bookmark"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/add_bookmark"
            android:text="@string/star_empty_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/home"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/home"
            android:text="@string/home_glyph"
            android:textColor="@color/text"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Where a video goes when a page asks for the whole screen. -->
    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />
</FrameLayout>
