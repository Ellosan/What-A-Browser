<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DeviceDefault rather than AppCompat: this app has no AppCompat dependency,
      because every library linked here is paid for at every cold start and cold
      start is the reason this build exists.
    -->
    <style name="Theme.Wat" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
