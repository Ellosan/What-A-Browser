    <string name="block_trackers">Block trackers</string>
    <string name="block_trackers_detail">Refuses requests to %1$d hosts whose only purpose is following people between sites. Chrome has no setting for this. It is not an ad blocker: hosts that also serve content are left alone, so pages keep working.</string>
    <string name="safe_browsing">Safe Browsing</string>
    <string name="safe_browsing_detail">Checks addresses against Google\'s phishing and malware list. That means the engine sends Google a partial hash of each address.</string>
    <string name="block_all_cookies">Refuse all cookies</string>
    <string name="block_all_cookies_detail">Signs you out of everything, everywhere. Third-party cookies are refused either way, and that is not a setting.</string>
