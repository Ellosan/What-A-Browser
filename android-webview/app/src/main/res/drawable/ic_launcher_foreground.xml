<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher mark: a rounded glass pane with the accent stroke of a "W".
  Vector rather than a bitmap so it is sharp at every density and costs nothing
  in the APK.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The glass pane. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.14"
        android:pathData="M30,28 L78,28 A10,10 0 0 1 88,38 L88,70 A10,10 0 0 1 78,80 L30,80 A10,10 0 0 1 20,70 L20,38 A10,10 0 0 1 30,28 Z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.35"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M30,28 L78,28 A10,10 0 0 1 88,38 L88,70 A10,10 0 0 1 78,80 L30,80 A10,10 0 0 1 20,70 L20,38 A10,10 0 0 1 30,28 Z" />

    <!-- The W. -->
    <path
        android:strokeColor="#FF7A1A"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M33,44 L41,64 L49,50 L57,64 L65,44" />
</vector>
