<?xml version="1.0" encoding="utf-8"?>
<!--
  What-A-Browser on Android.

  There is no Java in this app. The browser is a native library, and
  NativeActivity hands it a window and an event queue; everything from the HTML
  parser to the rasterizer is the same Rust that runs on the desktop.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A browser that cannot reach the network is not much of a browser. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Rendering is on the CPU, so no GPU feature is required. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:hasFragileUserData="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wat">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode">

            <!-- The library the activity loads: libwat_shell.so. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="wat_shell" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer to open links, like any other browser. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
